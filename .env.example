# ── PRODUCTION .env for server ────────────────────────────────────────────────
# Copy this file to .env on your server and fill in real values
# DO NOT commit .env to git

# Frontend (Vite) ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://calculator.rovark.in/api
# Set VITE_MOCK=false on server so it uses the real backend
VITE_MOCK=false

# Backend (FastAPI) ────────────────────────────────────────────────────────────
# PostgreSQL on production, SQLite for local dev
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/maxwell_acc

# Generate a real secret:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_openssl_rand_hex_32

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_NAME=Maxwell Accounting
