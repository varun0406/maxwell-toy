[Unit]
Description=Maxwell Accounting FastAPI Backend
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/maxwell/backend
EnvironmentFile=/var/www/maxwell/backend/.env
Environment="PATH=/var/www/maxwell/venv/bin"
ExecStart=/var/www/maxwell/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 9833 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
