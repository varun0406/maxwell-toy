[Unit]
Description=Maxwell Accounting FastAPI Backend
After=network.target postgresql.service

[Service]
Type=exec
User=root
WorkingDirectory=/root/maxwell-toy/backend
EnvironmentFile=/root/maxwell-toy/backend/.env
Environment="PATH=/root/maxwell-toy/venv/bin"
ExecStart=/root/maxwell-toy/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 9833 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
