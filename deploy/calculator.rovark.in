# /etc/nginx/sites-available/calculator.rovark.in
# ──────────────────────────────────────────────────────────────────────────────
# Maxwell Accounting — Nginx configuration
#
# SETUP STEPS ON SERVER:
#   1. sudo cp deploy/calculator.rovark.in /etc/nginx/sites-available/
#   2. sudo ln -s /etc/nginx/sites-available/calculator.rovark.in /etc/nginx/sites-enabled/
#   3. sudo certbot --nginx -d calculator.rovark.in   # Get SSL cert
#   4. sudo nginx -t && sudo systemctl reload nginx
# ──────────────────────────────────────────────────────────────────────────────

# Redirect HTTP → HTTPS
server {
    listen 80;
    server_name calculator.rovark.in;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name calculator.rovark.in;

    # SSL — managed bey certbot (certbot fills these in automatically)
    ssl_certificate     /etc/letsencrypt/live/calculator.rovark.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/calculator.rovark.in/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # ── Frontend (React/Vite dist) ─────────────────────────────────────────
    # The path where you cloned the repo + built the frontend
    root /root/maxwell-toy/frontend/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;  # SPA fallback for React Router
    }

    # ── Backend API (FastAPI running on port 9833) ─────────────────────────
    location /api/ {
        rewrite ^/api/(.*) /$1 break;
        proxy_pass         http://127.0.0.1:9833;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;

        # Allow larger uploads for Delivery Challan files
        client_max_body_size 20M;
    }

    # ── Security headers ──────────────────────────────────────────────────
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy strict-origin-when-cross-origin;
}
