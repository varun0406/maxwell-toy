<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config for Maxwell Accounting
  Allows cleartext HTTP traffic to your dev/production server.
  Remove or restrict the domain list before publishing to Play Store.
-->
<network-security-config>
    <!-- Allow all HTTP during debug testing -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Allow HTTP to your backend server (update IP/domain as needed) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Replace with your actual server IP or domain: -->
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">YOUR_SERVER_IP</domain>
    </domain-config>
</network-security-config>
